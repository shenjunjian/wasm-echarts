<Window x:Class="NetCoreDemo.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        Title="wasm-echarts NetCore Demo"
        Width="1280"
        Height="800"
        MinWidth="960"
        MinHeight="600"
        Background="#F6F7F9"
        FontFamily="Segoe UI, Microsoft YaHei UI"
        FontSize="13">
    <Window.Resources>
        <Style TargetType="Button" x:Key="HeaderButton">
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="BorderBrush" Value="#E2E5EA"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1A1D24"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="Button" x:Key="SmallButton">
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E2E5EA"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E2E5EA"
                BorderThickness="0,0,0,1"
                Padding="16,12">
            <Grid>
                <TextBlock VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           FontSize="15"
                           Foreground="#1A1D24"
                           Text="wasm-echarts NetCore"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ZrenderButton"
                            Style="{StaticResource HeaderButton}"
                            Content="wasm-zrender"
                            Click="OnZrenderClick"/>
                    <Button x:Name="EchartsButton"
                            Style="{StaticResource HeaderButton}"
                            Content="wasm-echarts"
                            Margin="0"
                            Click="OnEchartsClick"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" MinWidth="220"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="240"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*" MinWidth="280"/>
            </Grid.ColumnDefinitions>

            <DockPanel Grid.Column="0" Background="White">
                <Border DockPanel.Dock="Top"
                        Padding="16,14,16,10"
                        BorderBrush="#E2E5EA"
                        BorderThickness="0,0,0,1">
                    <StackPanel>
                        <TextBlock x:Name="SidebarTitle"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="#1A1D24"
                                   Text="wasm-zrender 实例"/>
                        <TextBlock x:Name="SidebarDesc"
                                   Margin="0,6,0,0"
                                   FontSize="12"
                                   Foreground="#5C6370"
                                   TextWrapping="Wrap"
                                   Text="对齐官方 zrender 示例。"/>
                    </StackPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="8">
                    <StackPanel x:Name="NavPanel"/>
                </ScrollViewer>
            </DockPanel>

            <GridSplitter Grid.Column="1"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          Background="#E2E5EA"/>

            <DockPanel Grid.Column="2" Background="#0F172A">
                <Border DockPanel.Dock="Top"
                        Padding="12,8"
                        BorderBrush="#1E293B"
                        BorderThickness="0,0,0,1">
                    <DockPanel>
                        <Button x:Name="CopyButton"
                                DockPanel.Dock="Right"
                                Style="{StaticResource SmallButton}"
                                Content="复制"
                                Click="OnCopyClick"/>
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#94A3B8"
                                   Text="源码"/>
                    </DockPanel>
                </Border>
                <avalonedit:TextEditor x:Name="SourceEditor"
                                       IsReadOnly="True"
                                       ShowLineNumbers="True"
                                       FontFamily="Cascadia Code, Consolas"
                                       FontSize="12.5"
                                       Foreground="#E2E8F0"
                                       Background="#0F172A"
                                       HorizontalScrollBarVisibility="Auto"
                                       VerticalScrollBarVisibility="Auto"
                                       Padding="8"/>
            </DockPanel>

            <GridSplitter Grid.Column="3"
                          Width="6"
                          HorizontalAlignment="Stretch"
                          Background="#E2E5EA"/>

            <DockPanel Grid.Column="4" Background="#FAFAFA">
                <Border DockPanel.Dock="Top"
                        Background="White"
                        Padding="12,8"
                        BorderBrush="#E2E5EA"
                        BorderThickness="0,0,0,1">
                    <DockPanel>
                        <TextBlock x:Name="StatusText"
                                   DockPanel.Dock="Right"
                                   VerticalAlignment="Center"
                                   FontSize="11"
                                   Foreground="#5C6370"
                                   Text=""/>
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="#5C6370"
                                   Text="预览"/>
                    </DockPanel>
                </Border>
                <Grid>
                    <Image x:Name="PreviewImage"
                           Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="NearestNeighbor"
                           Margin="16"/>
                    <Border x:Name="ErrorHost"
                            Margin="16"
                            Background="#FFFBEB"
                            BorderBrush="#FCD34D"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="14"
                            VerticalAlignment="Top"
                            Visibility="Collapsed">
                        <TextBlock x:Name="ErrorBanner"
                                   TextWrapping="Wrap"
                                   Foreground="#1A1D24"/>
                    </Border>
                </Grid>
            </DockPanel>
        </Grid>
    </Grid>
</Window>
